# Build a context -> {passage, questions:[{question, answers}]} structure
def build_context_pool(hf_split, min_questions=3, limit_contexts=None):
    by_context = {}
    for ex in hf_split:
        ctx = ex["context"]
        if ctx not in by_context:
            by_context[ctx] = {
                "title": ex.get("title", ""),
                "context": ctx,
                "questions": [],
            }
        answers = ex["answers"]["text"]
        if len(answers) == 0:
            continue
        by_context[ctx]["questions"].append({
            "id": ex["id"],
            "question": ex["question"],
            "answers": answers,
        })
    pool = [v for v in by_context.values() if len(v["questions"]) >= min_questions]
    if limit_contexts is not None:
        pool = pool[:limit_contexts]
    return pool

# Pull generously more than we need; Cell 6 will subsample deterministically.
_context_pool = build_context_pool(
    raw_squad["train"],
    min_questions=CFG["questions_per_context"] * 3,  # need enough Qs to split 3 ways
    limit_contexts=max(500, CFG["contexts"] * 10),
)
