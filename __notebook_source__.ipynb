# ---- 24a. Verifier validation against ground truth (validation split only) --
verifier_val_records = []
for ctx in EXPERIMENT_CONTEXTS[:min(10, len(EXPERIMENT_CONTEXTS))]:
    base_eval = evaluate_questions(BASE_POLICY_MODEL, policy_tokenizer, ctx["passage"],
                                    ctx["validation"], "validation", "reward_computation",
                                    max_new_tokens=CFG["max_new_tokens_answer"])
    for rec in base_eval["records"]:
        v = verify(rec["question"], rec["reference"], rec["prediction"], rec["prediction"])
        verifier_val_records.append({
            "ground_truth_em": rec["em"], "ground_truth_f1": rec["f1"],
            "verifier_correct": float(v["correct"]), "verifier_confidence": v["confidence"],
        })

verifier_val_df = pd.DataFrame(verifier_val_records)
if len(verifier_val_df) > 1 and verifier_val_df["verifier_correct"].nunique() > 1:
    gt_binary = (verifier_val_df["ground_truth_em"] > 0.5).astype(int)
    pred_binary = verifier_val_df["verifier_correct"].astype(int)
    tp = int(((gt_binary == 1) & (pred_binary == 1)).sum())
    fp = int(((gt_binary == 0) & (pred_binary == 1)).sum())
    fn = int(((gt_binary == 1) & (pred_binary == 0)).sum())
    tn = int(((gt_binary == 0) & (pred_binary == 0)).sum())
    precision = tp / (tp + fp) if (tp + fp) else 0.0
    recall = tp / (tp + fn) if (tp + fn) else 0.0
    f1v = 2 * precision * recall / (precision + recall) if (precision + recall) else 0.0
    accuracy = (tp + tn) / len(verifier_val_df)
    pearson_r, _ = scipy_stats.pearsonr(verifier_val_df["verifier_confidence"], verifier_val_df["ground_truth_f1"])
    spearman_r, _ = scipy_stats.spearmanr(verifier_val_df["verifier_confidence"], verifier_val_df["ground_truth_f1"])
else:
    accuracy = precision = recall = f1v = pearson_r = spearman_r = float("nan")

VERIFIER_VALIDATION = {
    "n": len(verifier_val_df), "accuracy": accuracy, "precision": precision,
    "recall": recall, "f1": f1v, "pearson_r": pearson_r, "spearman_r": spearman_r,
}
