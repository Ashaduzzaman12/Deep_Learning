SELF_EDIT_PROMPTS = {
    "implications": (
        "You are adapting a language model to permanently remember information.\n\n"
        "Given the following passage, generate several concise, factual training "
        "statements that help the model answer questions about the passage later "
        "WITHOUT seeing the passage.\n\n"
        "PASSAGE:\n{passage}\n\n"
        "Generate useful implications and factual statements.\n"
    ),
    "rewrite": (
        "Rewrite the following passage as a set of short, self-contained factual "
        "sentences that preserve all key information.\n\n"
        "PASSAGE:\n{passage}\n\n"
        "Rewritten factual sentences:\n"
    ),
    "self_qa": (
        "Given the following passage, write several question-answer pairs that "
        "capture its key facts, in the form 'Q: ... A: ...'.\n\n"
        "PASSAGE:\n{passage}\n\n"
        "Question-answer pairs:\n"
    ),
}

def generate_self_edits(model, tokenizer, passage, K, iteration, mode="implications",
                         max_new_tokens=96, temperature=0.9, top_p=0.95, base_seed=0):
    """Generate K sampled (not greedy) candidate self-edits for a passage."""
    assert mode in SELF_EDIT_PROMPTS, f"Unknown self-edit mode: {mode}"
    prompt = SELF_EDIT_PROMPTS[mode].format(passage=passage)
    inputs = tokenizer(prompt, return_tensors="pt", truncation=True, max_length=768).to(model.device)

    candidates = []
    for k in range(K):
        gen_seed = base_seed * 1000 + iteration * 100 + k
        torch.manual_seed(gen_seed)
        with torch.no_grad():
            out = model.generate(
                **inputs,
                max_new_tokens=max_new_tokens,
                do_sample=True,
                temperature=temperature,
                top_p=top_p,
                pad_token_id=tokenizer.pad_token_id,
            )
        text = tokenizer.decode(out[0][inputs["input_ids"].shape[1]:], skip_special_tokens=True)
        candidates.append({
            "candidate_id": f"iter{iteration}_k{k}",
            "edit_text": text.strip(),
            "generation_seed": gen_seed,
            "iteration": iteration,
            "mode": mode,
        })
    return candidates

print("Self-edit generator ready. Primary mode = 'implications'.")






# ============================================================
# CELL 10 (PATCHED): LORA INNER-LOOP ADAPTATION (+ CANDIDATE ISOLATION)
# ============================================================
#
# Fix: previously fresh_lora_policy() called get_peft_model(base_model, ...)
# fresh for every candidate, but that mutates BASE_POLICY_MODEL's modules
# in place. Repeated calls collided on the same "default" adapter, so
# discard_candidate_lora()'s .unload() on one candidate deleted parameters
# a still-alive persistent adapter (e.g. current_lora in continual learning)
# depended on -> "optimizer got an empty parameter list".
#
# Fix: wrap the base model into ONE shared PeftModel, give every candidate
# its own uniquely-named adapter via add_adapter(), and only ever
# delete_adapter() the specific name being discarded. A lightweight handle
# class keeps the same call surface (.train()/.eval()/.parameters()/
# forward/.generate()/.state_dict()) that the rest of the notebook expects.

def make_lora_config():
    return LoraConfig(
        r=CFG["lora_r"],
        lora_alpha=CFG["lora_alpha"],
        lora_dropout=CFG["lora_dropout"],
        bias="none",
        task_type=TaskType.CAUSAL_LM,
        target_modules=["q_proj", "k_proj", "v_proj", "o_proj"],
    )


_SHARED_PEFT_MODEL = None   # single PeftModel wrapping BASE_POLICY_MODEL, holds all adapters
_ADAPTER_COUNTER = 0


def _next_adapter_name():
    # Fixed-width, delimited name: "cand_000001_" can never be a substring
    # of "cand_000010_" etc, unlike bare "cand_1" / "cand_10". This matters
    # because .parameters()/.state_dict() below filter by substring match
    # on the adapter name -- an un-padded counter would silently leak
    # another candidate's parameters into this one's filtered view once the
    # counter passes 9 adapters in a session (easily hit in RESEARCH mode).
    global _ADAPTER_COUNTER
    _ADAPTER_COUNTER += 1
    return f"cand_{_ADAPTER_COUNTER:06d}_"


class CandidateLoRA:
    """Handle for one named LoRA adapter on the shared PeftModel.
    Activates its own adapter before every op, so multiple candidate
    handles (and a long-lived 'persistent' handle) can safely interleave
    without corrupting each other's parameters."""

    def __init__(self, shared_model, adapter_name):
        self.shared_model = shared_model
        self.adapter_name = adapter_name

    def _activate(self):
        self.shared_model.set_adapter(self.adapter_name)

    @property
    def device(self):
        return self.shared_model.device

    def train(self):
        self._activate()
        self.shared_model.train()
        return self

    def eval(self):
        self._activate()
        self.shared_model.eval()
        return self

    def __call__(self, **kwargs):
        self._activate()
        return self.shared_model(**kwargs)

    def generate(self, **kwargs):
        self._activate()
        return self.shared_model.generate(**kwargs)

    def parameters(self):
        self._activate()
        # Only this adapter's own LoRA params -- never another adapter's.
        return [p for n, p in self.shared_model.named_parameters()
                if p.requires_grad and self.adapter_name in n]

    def state_dict(self):
        self._activate()
        full = self.shared_model.state_dict()
        return {k: v.clone() for k, v in full.items() if self.adapter_name in k}

    def load_state_dict(self, sd):
        self._activate()
        self.shared_model.load_state_dict(sd, strict=False)

    def save_pretrained(self, path):
        self._activate()
        try:
            self.shared_model.save_pretrained(path, selected_adapters=[self.adapter_name])
        except TypeError:
            # older peft versions without selected_adapters kwarg
            self.shared_model.save_pretrained(path)

    def print_trainable_parameters(self):
        self.shared_model.print_trainable_parameters()


def fresh_lora_policy(base_model):
    """Attach a brand-new, uniquely-named LoRA adapter to the (single,
    shared) PeftModel wrapping the frozen base. Base weights are untouched;
    only this candidate's own LoRA params are trainable. Guarantees
    isolation from every other candidate/persistent adapter."""
    global _SHARED_PEFT_MODEL
    lora_cfg = make_lora_config()
    name = _next_adapter_name()
    if _SHARED_PEFT_MODEL is None:
        if hasattr(base_model, "peft_config"):
            raise RuntimeError(
                "BASE_POLICY_MODEL already carries a stale `peft_config` "
                "from an earlier run in this kernel session, but "
                "_SHARED_PEFT_MODEL (this cell's own bookkeeping) is None. "
                "This combination means the kernel was not fully restarted "
                "after a code change, which will silently corrupt candidate "
                "isolation if allowed to proceed (PEFT will warn 'modifying "
                "a model with PEFT for a second time' and adapters will "
                "eventually lose their parameters out from under a "
                "long-lived handle). "
                "FIX: Session > Restart Session (a full restart, not just "
                "'clear output'), then Run All from Cell 1 top to bottom "
                "without skipping or reordering cells."
            )
        _SHARED_PEFT_MODEL = get_peft_model(base_model, lora_cfg, adapter_name=name)
    else:
        _SHARED_PEFT_MODEL.add_adapter(name, lora_cfg)
    handle = CandidateLoRA(_SHARED_PEFT_MODEL, name)
    handle._activate()
    handle.print_trainable_parameters()
    return handle


def discard_candidate_lora(handle):
    """Explicitly discard a candidate's LoRA weights and free memory.
    Only deletes THIS adapter -- never touches any other live adapter."""
    try:
        handle.shared_model.delete_adapter(handle.adapter_name)
    except Exception as e:
        print(f"Warning: failed to delete adapter {handle.adapter_name}: {e}")
    del handle
    gc.collect()
    if torch.cuda.is_available():
        torch.cuda.empty_cache()


class SelfEditTextDataset(TorchDataset):
    """Simple next-token LM dataset over one self-edit's generated text."""
    def __init__(self, tokenizer, text, max_length=256):
        self.tokenizer = tokenizer
        enc = tokenizer(text, truncation=True, max_length=max_length, return_tensors="pt")
        self.input_ids = enc["input_ids"][0]
        self.attn_mask = enc["attention_mask"][0]

    def __len__(self):
        return 1

    def __getitem__(self, idx):
        return {
            "input_ids": self.input_ids,
            "attention_mask": self.attn_mask,
            "labels": self.input_ids.clone(),
        }


def train_candidate_lora(peft_model, tokenizer, edit_text, steps, lr):
    """Train a candidate's fresh LoRA adapter on its own self-edit text."""
    peft_model.train()
    optimizer = torch.optim.AdamW(peft_model.parameters(), lr=lr)
    ds = SelfEditTextDataset(tokenizer, edit_text)
    batch = ds[0]
    batch = {k: v.unsqueeze(0).to(peft_model.device) for k, v in batch.items()}

    losses = []
    tokens_trained = 0
    for step in range(steps):
        optimizer.zero_grad()
        out = peft_model(**batch)
        loss = out.loss
        loss.backward()
        optimizer.step()
        losses.append(loss.item())
        tokens_trained += batch["input_ids"].numel()
    peft_model.eval()
    return {"losses": losses, "tokens_trained": tokens_trained, "steps": steps}


print("LoRA inner-loop adaptation functions ready (patched: named-adapter isolation).")
