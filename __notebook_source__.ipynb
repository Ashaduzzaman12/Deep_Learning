# CELL 13: REWARD CALCULATION
# ============================================================
def compute_candidate_reward(model_before_metrics, model_after_metrics,
                              generalization_before=None, generalization_after=None,
                              forgetting_penalty=0.0,
                              alpha=ALPHA, beta=BETA, gamma=GAMMA):
    """R = alpha*delta_A_target + beta*delta_A_generalization - gamma*R_forgetting
    Defaults (alpha=1,beta=0,gamma=0) reduce this to the primary reward: R = delta_A_validation."""
    delta_target = model_after_metrics["EM"] - model_before_metrics["EM"]
    delta_generalization = 0.0
    if generalization_before is not None and generalization_after is not None:
        delta_generalization = generalization_after["EM"] - generalization_before["EM"]
    reward = alpha * delta_target + beta * delta_generalization - gamma * forgetting_penalty
    return {
        "reward": reward,
        "delta_target": delta_target,
        "delta_generalization": delta_generalization,
        "forgetting_penalty": forgetting_penalty,
    }

print("Reward function ready. Primary reward R = delta_accuracy on VALIDATION split.")
print(f"Composite weights: alpha={ALPHA} beta={BETA} gamma={GAMMA} (simple mode)")







# ============================================================
# CELL 14: RFT IMPLEMENTATION
# ============================================================
def rft_outer_step(base_model, tokenizer, ctx, iteration, seed, evaluation_cache, compute_log):
    """One outer-loop RFT step for a single context. Returns chosen candidate
    (or None) and full per-candidate logs."""
    passage = ctx["passage"]
    candidates = generate_self_edits(base_model, tokenizer, passage, CFG["K"], iteration,
                                      mode="implications",
                                      max_new_tokens=CFG["max_new_tokens_edit"], base_seed=seed)
    compute_log["self_edit_generations"] += len(candidates)

    before_metrics = evaluate_questions(base_model, tokenizer, passage, ctx["validation"],
                                         "validation", "reward_computation",
                                         max_new_tokens=CFG["max_new_tokens_answer"])

    results = []
    for cand in candidates:
        peft_model = fresh_lora_policy(base_model)
        train_stats = train_candidate_lora(peft_model, tokenizer, cand["edit_text"],
                                            steps=CFG["inner_steps"], lr=CFG["lr"])
        compute_log["lora_training_steps"] += train_stats["steps"]
        compute_log["training_tokens"] += train_stats["tokens_trained"]

        after_metrics = evaluate_questions(peft_model, tokenizer, passage, ctx["validation"],
                                            "validation", "reward_computation",
                                            max_new_tokens=CFG["max_new_tokens_answer"])
        compute_log["candidate_evaluations"] += 1

        reward_info = compute_candidate_reward(before_metrics, after_metrics)
        results.append({**cand, "reward": reward_info["reward"],
                         "delta_accuracy": reward_info["delta_target"],
                         "before_EM": before_metrics["EM"], "after_EM": after_metrics["EM"]})
        discard_candidate_lora(peft_model)

    positive = [r for r in results if r["reward"] > 0]
    chosen = max(positive, key=lambda r: r["reward"]) if positive else None
    return chosen, results, before_metrics

print("RFT (positive-only) baseline ready.")







# ============================================================
# CELL 15: NFT (ADAPTED) IMPLEMENTATION
# ============================================================
def estimate_reward_statistics(rewards):
    rewards = np.asarray(rewards, dtype=np.float64)
    mu = rewards.mean()
    sigma = rewards.std() + EPS
    return {"mean": float(mu), "std": float(sigma)}

def compute_nft_weights(rewards, stats):
    """Standardize rewards, clip to a safe range. Can be negative (down-weighting
    failed candidates' log-prob) -- this is the 'negative learning' component."""
    rewards = np.asarray(rewards, dtype=np.float64)
    z = (rewards - stats["mean"]) / stats["std"]
    z = np.clip(z, -CLIP_MAX, CLIP_MAX)
    # avoid a fully-flat weight vector when all rewards are identical
    if np.allclose(z, 0):
        z = z + EPS
    return z

def compute_nft_loss(peft_model, tokenizer, edit_text, weight):
    """weight > 0 => standard NLL minimization (encourage).
    weight < 0 => NLL maximization (discourage), clipped for stability."""
    ds = SelfEditTextDataset(tokenizer, edit_text)
    batch = ds[0]
    batch = {k: v.unsqueeze(0).to(peft_model.device) for k, v in batch.items()}
    out = peft_model(**batch)
    nll = out.loss
    signed_weight = float(np.clip(weight, -CLIP_MAX, CLIP_MAX))
    loss = signed_weight * nll
    return loss, nll.item()

def train_nft_step(peft_model, tokenizer, candidates_with_weights, lr):
    peft_model.train()

    trainable_params = [p for p in peft_model.parameters() if p.requires_grad]
    if not trainable_params:
        raise RuntimeError(
            "train_nft_step received a model with zero trainable parameters. "
            "This usually means the LoRA adapter was merged/unloaded earlier "
            "(e.g. via merge_and_unload()) and the model was never re-wrapped "
            "with fresh_lora_policy(...) before this call. Fix at the call site, "
            "not here."
        )

    optimizer = torch.optim.AdamW(trainable_params, lr=lr)
    total_loss = 0.0
    tokens_trained = 0

    for cand, weight in candidates_with_weights:
        optimizer.zero_grad()
        loss, nll = compute_nft_loss(peft_model, tokenizer, cand["edit_text"], weight)
        loss.backward()
        torch.nn.utils.clip_grad_norm_(trainable_params, max_norm=1.0)
        optimizer.step()
        total_loss += loss.item()
        tokens_trained += tokenizer(cand["edit_text"], return_tensors="pt")["input_ids"].numel()

    peft_model.eval()
    return {"total_loss": total_loss, "tokens_trained": tokens_trained}
    
def nft_outer_step(base_model, tokenizer, ctx, iteration, seed, compute_log):
    """One outer-loop adapted-NFT step: evaluate K candidates individually (each
    on its own fresh LoRA, per candidate-isolation rule), then apply the
    resulting standardized-weighted update to a SINGLE fresh LoRA used for the
    persistent policy step."""
    passage = ctx["passage"]
    candidates = generate_self_edits(base_model, tokenizer, passage, CFG["K"], iteration,
                                      mode="implications",
                                      max_new_tokens=CFG["max_new_tokens_edit"], base_seed=seed)
    compute_log["self_edit_generations"] += len(candidates)

    before_metrics = evaluate_questions(base_model, tokenizer, passage, ctx["validation"],
                                         "validation", "reward_computation",
                                         max_new_tokens=CFG["max_new_tokens_answer"])

    rewards = []
    for cand in candidates:
        peft_model = fresh_lora_policy(base_model)
        train_candidate_lora(peft_model, tokenizer, cand["edit_text"],
                              steps=CFG["inner_steps"], lr=CFG["lr"])
        compute_log["lora_training_steps"] += CFG["inner_steps"]
        after_metrics = evaluate_questions(peft_model, tokenizer, passage, ctx["validation"],
                                            "validation", "reward_computation",
                                            max_new_tokens=CFG["max_new_tokens_answer"])
        compute_log["candidate_evaluations"] += 1
        r = compute_candidate_reward(before_metrics, after_metrics)
        rewards.append(r["reward"])
        cand["after_EM"] = after_metrics["EM"]
        discard_candidate_lora(peft_model)

    stats = estimate_reward_statistics(rewards)
    weights = compute_nft_weights(rewards, stats)

    # Apply the weighted update to a fresh persistent-step LoRA
    persistent_lora = fresh_lora_policy(base_model)
    step_stats = train_nft_step(persistent_lora, tokenizer,
                                 list(zip(candidates, weights)), lr=CFG["lr"])
    compute_log["training_tokens"] += step_stats["tokens_trained"]

    results = [{**c, "reward": rw, "weight": float(w), "delta_accuracy": rw}
               for c, rw, w in zip(candidates, rewards, weights)]
    return persistent_lora, results, before_metrics, stats

print("Adapted NFT baseline ready (positive AND negative candidates used).")







# ============================================================
# CELL 16: NEGATIVE-SFT BASELINE
# ============================================================
def negative_sft_loss(peft_model, tokenizer, positive_edit, negative_edit, neg_weight=NEGATIVE_WEIGHT):
    pos_ds = SelfEditTextDataset(tokenizer, positive_edit)
    pos_batch = {k: v.unsqueeze(0).to(peft_model.device) for k, v in pos_ds[0].items()}
    pos_out = peft_model(**pos_batch)
    pos_nll = pos_out.loss

    loss = pos_nll
    neg_nll_val = None
    if negative_edit is not None:
        neg_ds = SelfEditTextDataset(tokenizer, negative_edit)
        neg_batch = {k: v.unsqueeze(0).to(peft_model.device) for k, v in neg_ds[0].items()}
        neg_out = peft_model(**neg_batch)
        neg_nll = neg_out.loss
        loss = pos_nll + neg_weight * neg_nll  # maximize neg_nll => discourage
        neg_nll_val = neg_nll.item()
    return loss, pos_nll.item(), neg_nll_val


def negative_sft_outer_step(base_model, tokenizer, ctx, iteration, seed, compute_log):
    passage = ctx["passage"]
    candidates = generate_self_edits(base_model, tokenizer, passage, CFG["K"], iteration,
                                      mode="implications",
                                      max_new_tokens=CFG["max_new_tokens_edit"], base_seed=seed)
    compute_log["self_edit_generations"] += len(candidates)

    before_metrics = evaluate_questions(base_model, tokenizer, passage, ctx["validation"],
                                         "validation", "reward_computation",
                                         max_new_tokens=CFG["max_new_tokens_answer"])

    scored = []
    for cand in candidates:
        peft_model = fresh_lora_policy(base_model)
        train_candidate_lora(peft_model, tokenizer, cand["edit_text"],
                              steps=CFG["inner_steps"], lr=CFG["lr"])
        compute_log["lora_training_steps"] += CFG["inner_steps"]
        after_metrics = evaluate_questions(peft_model, tokenizer, passage, ctx["validation"],
                                            "validation", "reward_computation",
                                            max_new_tokens=CFG["max_new_tokens_answer"])
        compute_log["candidate_evaluations"] += 1
        r = compute_candidate_reward(before_metrics, after_metrics)
        scored.append({**cand, "reward": r["reward"], "delta_accuracy": r["delta_target"]})
        discard_candidate_lora(peft_model)

    scored_sorted = sorted(scored, key=lambda x: x["reward"])
    best_pos = scored_sorted[-1]
    worst_neg = scored_sorted[0] if scored_sorted[0]["reward"] < best_pos["reward"] else None

    persistent_lora = fresh_lora_policy(base_model)
    persistent_lora.train()
    optimizer = torch.optim.AdamW([p for p in persistent_lora.parameters() if p.requires_grad], lr=CFG["lr"])
    optimizer.zero_grad()
    loss, pos_nll, neg_nll = negative_sft_loss(
        persistent_lora, tokenizer, best_pos["edit_text"],
        worst_neg["edit_text"] if worst_neg else None
    )
    loss.backward()
    optimizer.step()
    persistent_lora.eval()
    compute_log["training_tokens"] += tokenizer(best_pos["edit_text"], return_tensors="pt")["input_ids"].numel()

    return persistent_lora, scored, before_metrics, {"pos_nll": pos_nll, "neg_nll": neg_nll}

print("Negative-SFT baseline ready (lambda =", NEGATIVE_WEIGHT, ").")







# ============================================================
# CELL 17: FAILURE MEMORY, CLASSIFICATION, REPEATED-FAILURE METRIC
# ============================================================
class FailureMemory:
    def __init__(self, size=MEMORY_SIZE):
        self.buffer = deque(maxlen=size)

    def add(self, record):
        self.buffer.append(record)

    def __len__(self):
        return len(self.buffer)

    def all(self):
        return list(self.buffer)


def classify_failure(delta_accuracy, generalization_delta=0.0, retention_delta=0.0,
                      train_loss_trend=None):
    """Deterministic rule-based classification (Sec. 24)."""
    if delta_accuracy <= 0 and (train_loss_trend is not None and train_loss_trend < -0.3):
        return "OVERFITTING"
    if retention_delta < -0.05:
        return "CATASTROPHIC_FORGETTING"
    if delta_accuracy < -0.02:
        return "TARGET_REGRESSION"
    if generalization_delta < -0.02 and delta_accuracy >= 0:
        return "POOR_GENERALIZATION"
    return "NO_IMPROVEMENT"


def text_similarity(a, b):
    """Cheap normalized token-overlap similarity in [0,1]."""
    ta, tb = set(normalize_answer(a).split()), set(normalize_answer(b).split())
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / len(ta | tb)


def repeated_failure_rate(failure_records, sim_threshold=0.7):
    if len(failure_records) < 2:
        return 0.0
    repeated = 0
    seen_texts = []
    for rec in failure_records:
        is_repeat = any(text_similarity(rec["edit_text"], s) >= sim_threshold for s in seen_texts)
        if is_repeat:
            repeated += 1
        seen_texts.append(rec["edit_text"])
    return repeated / len(failure_records)


GLOBAL_FAILURE_MEMORY = FailureMemory(size=MEMORY_SIZE)
print(f"Failure memory ready. Capacity = {MEMORY_SIZE}.")







# ============================================================
# CELL 18: ROLLBACK
# ============================================================
def save_policy_checkpoint(peft_model, tag):
    path = os.path.join(OUTPUT_ROOT, "checkpoints", tag)
    os.makedirs(path, exist_ok=True)
    peft_model.save_pretrained(path)
    return path

def rollback_gate(before_val_EM, after_val_EM, retention_before=None, retention_after=None,
                   threshold=ROLLBACK_THRESHOLD):
    """Returns (should_rollback: bool, reason: str). Uses validation only."""
    val_drop = before_val_EM - after_val_EM
    if val_drop > threshold:
        return True, f"validation EM dropped by {val_drop:.4f} > threshold {threshold}"
    if retention_before is not None and retention_after is not None:
        ret_drop = retention_before - retention_after
        if ret_drop > threshold:
            return True, f"retention dropped by {ret_drop:.4f} > threshold {threshold}"
    return False, "improvement retained"

print(f"Rollback gate ready. Threshold = {ROLLBACK_THRESHOLD} (validation-based only).")







# ============================================================
# CELL 19: FASA (FAILURE-AWARE NFT) IMPLEMENTATION
# ============================================================
def fasa_outer_step(base_model, tokenizer, ctx, iteration, seed, compute_log,
                     failure_memory: FailureMemory,
                     use_nft=True, use_memory=True, use_rollback=True,
                     current_best_checkpoint_state=None):
    """One outer-loop FASA step. Returns:
       persistent_lora (or None if rolled back), results, before_metrics,
       rollback_info, updated retained-state marker."""
    passage = ctx["passage"]
    candidates = generate_self_edits(base_model, tokenizer, passage, CFG["K"], iteration,
                                      mode="implications",
                                      max_new_tokens=CFG["max_new_tokens_edit"], base_seed=seed)
    compute_log["self_edit_generations"] += len(candidates)

    before_metrics = evaluate_questions(base_model, tokenizer, passage, ctx["validation"],
                                         "validation", "reward_computation",
                                         max_new_tokens=CFG["max_new_tokens_answer"])

    rewards, per_candidate_after = [], []
    for cand in candidates:
        peft_model = fresh_lora_policy(base_model)
        train_candidate_lora(peft_model, tokenizer, cand["edit_text"],
                              steps=CFG["inner_steps"], lr=CFG["lr"])
        compute_log["lora_training_steps"] += CFG["inner_steps"]
        after_metrics = evaluate_questions(peft_model, tokenizer, passage, ctx["validation"],
                                            "validation", "reward_computation",
                                            max_new_tokens=CFG["max_new_tokens_answer"])
        compute_log["candidate_evaluations"] += 1
        r = compute_candidate_reward(before_metrics, after_metrics)
        rewards.append(r["reward"])
        per_candidate_after.append(after_metrics["EM"])
        discard_candidate_lora(peft_model)

        # ---- Failure memory + classification ----
        if use_memory and r["reward"] <= 0:
            failure_type = classify_failure(delta_accuracy=r["delta_target"])
            failure_memory.add({
                "context_id": ctx["context_id"], "edit": cand["edit_text"],
                "reward": r["reward"], "delta_accuracy": r["delta_target"],
                "failure_type": failure_type, "iteration": iteration, "seed": seed,
            })

    if use_nft:
        stats = estimate_reward_statistics(rewards)
        weights = compute_nft_weights(rewards, stats)
    else:
        # falls back to RFT-style positive-only weighting if NFT switched off
        weights = np.array([1.0 if r > 0 else 0.0 for r in rewards])
        stats = estimate_reward_statistics(rewards)

    persistent_lora = fresh_lora_policy(base_model)
    step_stats = train_nft_step(persistent_lora, tokenizer,
                                 list(zip(candidates, weights)), lr=CFG["lr"])
    compute_log["training_tokens"] += step_stats["tokens_trained"]

    # ---- Validation gate + rollback ----
    after_update_metrics = evaluate_questions(persistent_lora, tokenizer, passage, ctx["validation"],
                                               "validation", "reward_computation",
                                               max_new_tokens=CFG["max_new_tokens_answer"])
    compute_log["candidate_evaluations"] += 1

    rollback_info = {"rolled_back": False, "reason": "rollback disabled"}
    if use_rollback:
        should_rollback, reason = rollback_gate(before_metrics["EM"], after_update_metrics["EM"])
        rollback_info = {"rolled_back": should_rollback, "reason": reason}
        if should_rollback:
            discard_candidate_lora(persistent_lora)
            persistent_lora = None  # signal caller: keep previous policy state

    results = [{**c, "reward": rw, "weight": float(w), "delta_accuracy": rw}
               for c, rw, w in zip(candidates, rewards, weights)]
    return persistent_lora, results, before_metrics, after_update_metrics, rollback_info

print("FASA (Failure-Aware NFT) ready. Components: NFT + Memory + Classification + Gate + Rollback.")







