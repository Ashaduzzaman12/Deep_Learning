def evaluations_to_reach_target(df, method, target_delta):
    sub = df[df["method"] == method].sort_values(["seed", "context_id", "iteration"])
    base_em = per_method_seed_em["Base"].mean() if len(per_method_seed_em.get("Base", [])) else 0.0
    target = base_em + target_delta
    counts = []
    for seed, seed_sub in sub.groupby("seed"):
        n_eval = 0
        reached = False
        for _, row in seed_sub.iterrows():
            n_eval += 1
            if row["after_EM"] >= target:
                reached = True
                break
        counts.append(n_eval if reached else None)
    achieved = [c for c in counts if c is not None]
    return {
        "target_delta": target_delta,
        "achievable": len(achieved) > 0,
        "mean_evaluations": float(np.mean(achieved)) if achieved else None,
        "n_seeds_achieved": len(achieved),
        "n_seeds_total": len(counts),
    }

efficiency_rows = []
for method in ["RFT", "NFT", "Negative-SFT", "FASA"]:
    for target_delta in [0.02, 0.05, 0.10]:
        res = evaluations_to_reach_target(main_results_df, method, target_delta)
        efficiency_rows.append({"method": method, **res})

    sub = main_results_df[main_results_df["method"] == method]
    delta_acc = sub["after_EM"].mean() - per_method_seed_em["Base"].mean()
    n_evals = len(sub)
    efficiency_rows.append({"method": method, "target_delta": "overall",
                             "achievable": True, "mean_evaluations": n_evals,
                             "efficiency_delta_per_eval": delta_acc / max(n_evals, 1),
                             "n_seeds_achieved": None, "n_seeds_total": None})

efficiency_df = pd.DataFrame(efficiency_rows)
