# ------------------------------------------------------------
# Model resolver
# ------------------------------------------------------------

def resolve_available_model(candidates, token=None):
    """Return the first candidate that is actually reachable/authorized."""

    for cand in candidates:
        try:
            info = model_info(
                cand,
                token=token,
            )

            n_params = None

            if (
                getattr(info, "safetensors", None)
                and info.safetensors.total is not None
            ):
                n_params = info.safetensors.total

            print(
                f"  [OK] {cand} "
                f"(params reported: {n_params})"
            )

            return cand

        except GatedRepoError:

            print(
                f"  [GATED/NO ACCESS] {cand} "
                f"-- requires accepted license + HF_TOKEN access."
            )

        except RepositoryNotFoundError:

            print(
                f"  [NOT FOUND] {cand}"
            )

        except HfHubHTTPError as e:

            print(
                f"  [HTTP ERROR] {cand}: {e}"
            )

        except Exception as e:

            print(
                f"  [ERROR] {cand}: {e}"
            )

    return None


