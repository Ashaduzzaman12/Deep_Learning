# CELL 6: DATASET SPLIT AND LEAKAGE PROTECTION
# ============================================================

class DatasetGuard:
    """Runtime guard preventing test-split data from being used anywhere
    other than final held-out evaluation."""

    _TEST_EVAL_ACTIVE = False  # set True only inside the final-eval context manager

    class _AllowTestEval:
        def __enter__(self):
            DatasetGuard._TEST_EVAL_ACTIVE = True
            return self
        def __exit__(self, *exc):
            DatasetGuard._TEST_EVAL_ACTIVE = False

    @classmethod
    def allow_test_eval(cls):
        return cls._AllowTestEval()

    @staticmethod
    def check(split: str, purpose: str):
        """Call this at every site that consumes a batch of questions."""
        if split == "test":
            assert purpose == "final_held_out_eval", (
                f"DATA LEAKAGE BLOCKED: attempted to use TEST split for '{purpose}'. "
                f"Test data may only be used via DatasetGuard.allow_test_eval() "
                f"in the final evaluation step."
            )
            assert DatasetGuard._TEST_EVAL_ACTIVE, (
                "DATA LEAKAGE BLOCKED: test split used outside of an "
                "allow_test_eval() context."
            )
        elif split not in ("adaptation", "validation"):
            raise ValueError(f"Unknown split label: {split}")


def make_context_splits(context_pool, n_contexts, q_per_context, seed=0):
    """For each selected context, split its questions into
    adaptation / validation / test (deterministically shuffled)."""
    rng = random.Random(seed)
    pool = context_pool[:]  # already order-stable from Cell 5
    rng.shuffle(pool)
    selected = pool[:n_contexts]

    dataset_contexts = []
    for i, ctx in enumerate(selected):
        qs = ctx["questions"][:]
        rng.shuffle(qs)
        need = q_per_context * 3
        qs = qs[:need] if len(qs) >= need else qs
        n = len(qs) // 3
        adaptation_qs = qs[:n][:q_per_context]
        validation_qs = qs[n:2*n][:q_per_context]
        test_qs = qs[2*n:3*n][:q_per_context]
        if min(len(adaptation_qs), len(validation_qs), len(test_qs)) == 0:
            continue
        dataset_contexts.append({
            "context_id": f"ctx_{i:04d}",
            "passage": ctx["context"],
            "title": ctx["title"],
            "adaptation": adaptation_qs,
            "validation": validation_qs,
            "test": test_qs,
        })
    return dataset_contexts


EXPERIMENT_CONTEXTS = make_context_splits(
