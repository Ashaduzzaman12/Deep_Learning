# ---- 24b. Reward-noise robustness -------------------------------------------
def corrupt_rewards(rewards, corrupt_frac, rng):
    rewards = np.array(rewards, dtype=np.float64)
    mask = rng.random(len(rewards)) < corrupt_frac
    rewards[mask] = -rewards[mask]
    return rewards

def run_noise_condition(method_label, corrupt_frac, seed, contexts, outer_iterations):
    rng = np.random.RandomState(seed * 7919 + int(corrupt_frac * 1000))
    set_all_seeds(seed)
    all_final_em = []
    for ctx in contexts[:min(3, len(contexts))]:  # small subset for the sweep (compute budget)
        for it in range(outer_iterations):
            candidates = generate_self_edits(BASE_POLICY_MODEL, policy_tokenizer, ctx["passage"],
                                               CFG["K"], it, mode="implications",
                                               max_new_tokens=CFG["max_new_tokens_edit"], base_seed=seed)
            before = evaluate_questions(BASE_POLICY_MODEL, policy_tokenizer, ctx["passage"],
                                         ctx["validation"], "validation", "reward_computation",
                                         max_new_tokens=CFG["max_new_tokens_answer"])
            rewards = []
            for cand in candidates:
                trial = fresh_lora_policy(BASE_POLICY_MODEL)
                train_candidate_lora(trial, policy_tokenizer, cand["edit_text"], CFG["inner_steps"], CFG["lr"])
                after = evaluate_questions(trial, policy_tokenizer, ctx["passage"], ctx["validation"],
                                            "validation", "reward_computation",
                                            max_new_tokens=CFG["max_new_tokens_answer"])
                rewards.append(after["EM"] - before["EM"])
                discard_candidate_lora(trial)
            noisy_rewards = corrupt_rewards(rewards, corrupt_frac, rng)

            if method_label == "RFT":
                pos_idx = [i for i, r in enumerate(noisy_rewards) if r > 0]
                final_em = before["EM"] if not pos_idx else before["EM"] + max(noisy_rewards[pos_idx])
            else:  # NFT / FASA both use standardized weights here for the sweep
                stats = estimate_reward_statistics(noisy_rewards)
                weights = compute_nft_weights(noisy_rewards, stats)
                final_em = before["EM"] + float(np.dot(weights, noisy_rewards)) / max(len(weights), 1)
            all_final_em.append(final_em)
            gc.collect()
            if torch.cuda.is_available():
                torch.cuda.empty_cache()
    return float(np.mean(all_final_em)) if all_final_em else float("nan")


NOISE_LEVELS = [0.0, 0.05, 0.10, 0.20, 0.30]
noise_results = []
for method_label in ["RFT", "NFT", "FASA"]:
    for cf in NOISE_LEVELS:
        val = run_noise_condition(method_label, cf, DEFAULT_SEED, EXPERIMENT_CONTEXTS,
                                   outer_iterations=1 if DEBUG else 2)
        noise_results.append({"method": method_label, "corrupt_frac": cf, "final_EM": val})
        print(f"  noise sweep: method={method_label} corrupt_frac={cf} -> EM={val:.4f}")
