# ---- 24c. Reward-sparsity robustness -----------------------------------------
def run_sparsity_condition(method_label, success_rate_target, seed, contexts, outer_iterations):
    set_all_seeds(seed)
    all_final_em = []
    for ctx in contexts[:min(3, len(contexts))]:
        for it in range(outer_iterations):
            candidates = generate_self_edits(BASE_POLICY_MODEL, policy_tokenizer, ctx["passage"],
                                               CFG["K"], it, mode="implications",
                                               max_new_tokens=CFG["max_new_tokens_edit"], base_seed=seed)
            before = evaluate_questions(BASE_POLICY_MODEL, policy_tokenizer, ctx["passage"],
                                         ctx["validation"], "validation", "reward_computation",
                                         max_new_tokens=CFG["max_new_tokens_answer"])
            raw_rewards = []
            for cand in candidates:
                trial = fresh_lora_policy(BASE_POLICY_MODEL)
                train_candidate_lora(trial, policy_tokenizer, cand["edit_text"], CFG["inner_steps"], CFG["lr"])
                after = evaluate_questions(trial, policy_tokenizer, ctx["passage"], ctx["validation"],
                                            "validation", "reward_computation",
                                            max_new_tokens=CFG["max_new_tokens_answer"])
                raw_rewards.append(after["EM"] - before["EM"])
                discard_candidate_lora(trial)
            raw_rewards = np.array(raw_rewards)
            # threshold rewards so ~success_rate_target fraction are "successful" (>0)
            if len(raw_rewards) > 0:
                thresh = np.quantile(raw_rewards, 1 - success_rate_target)
                sparse_rewards = raw_rewards - thresh
            else:
                sparse_rewards = raw_rewards

            if method_label == "RFT":
                pos_idx = [i for i, r in enumerate(sparse_rewards) if r > 0]
                final_em = before["EM"] if not pos_idx else before["EM"] + max(sparse_rewards[pos_idx])
            else:
                stats = estimate_reward_statistics(sparse_rewards)
                weights = compute_nft_weights(sparse_rewards, stats)
                final_em = before["EM"] + float(np.dot(weights, sparse_rewards)) / max(len(weights), 1)
            all_final_em.append(final_em)
            gc.collect()
            if torch.cuda.is_available():
                torch.cuda.empty_cache()
    return float(np.mean(all_final_em)) if all_final_em else float("nan")


SPARSITY_LEVELS = [0.50, 0.25, 0.10, 0.05]
sparsity_results = []
for method_label in ["RFT", "NFT", "FASA"]:
