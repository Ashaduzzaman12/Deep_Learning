# ------------------------------------------------------------
# Prompt
# ------------------------------------------------------------

VERIFIER_PROMPT = """You are a strict factual answer verifier.

Determine whether the candidate answer correctly answers
the question according to the reference answer.

Judge factual correctness rather than writing style.

A candidate should be marked incorrect if it contains a
meaningful factual error, contradiction, or unsupported claim.

Return ONLY one valid JSON object.

Required format:
{{"correct": true, "confidence": 0.95, "error_type": "none"}}

Allowed error_type values:
none
factual_error
incomplete
contradiction
irrelevant
unsupported
unparseable

Question:
{question}

Reference answer:
{reference}

Candidate answer:
{candidate}

JSON:
"""


# ------------------------------------------------------------
# Cache key
# ------------------------------------------------------------

def _cache_key(
    question,
    reference,
    policy_answer,
    baseline_answer,
):

    payload = json.dumps(
        {
            "q": question,
            "ref": reference,
            "policy": policy_answer,
            "baseline": baseline_answer,
        },
        sort_keys=True,
    )

    return hashlib.sha256(
        payload.encode("utf-8")
    ).hexdigest()


# ------------------------------------------------------------
# Parse verifier JSON
# ------------------------------------------------------------

def _parse_verifier_json(text):

    if not text:

        return {
            "correct": False,
            "confidence": 0.0,
            "error_type": "unparseable",
        }


    # --------------------------------------------------------
    # Look for JSON objects
    # --------------------------------------------------------

    candidates = re.findall(
        r"\{.*?\}",
        text,
        flags=re.DOTALL,
    )


    # --------------------------------------------------------
    # Try last candidate first
    # --------------------------------------------------------

    for candidate in reversed(candidates):

        try:

            obj = json.loads(candidate)

            confidence = float(
                obj.get(
                    "confidence",
                    0.0,
                )
            )

            confidence = max(
                0.0,
                min(
                    1.0,
                    confidence,
                ),
            )

            return {
                "correct": bool(
                    obj.get(
                        "correct",
                        False,
                    )
                ),
                "confidence": confidence,
                "error_type": str(
                    obj.get(
                        "error_type",
                        "none",
                    )
                ),
            }

        except Exception:

            continue


    return {
        "correct": False,
        "confidence": 0.0,
        "error_type": "unparseable",
    }


# ------------------------------------------------------------
# Local verifier
# ------------------------------------------------------------

def call_verifier_local(
    question,
    reference,
    policy_answer,
    baseline_answer,
):

    if _verifier_model is None:

        raise RuntimeError(
            "Verifier model is not loaded."
        )


    prompt = VERIFIER_PROMPT.format(
        question=question,
        reference=reference,
        candidate=policy_answer,
    )


    # --------------------------------------------------------
    # Tokenize on CPU
    # --------------------------------------------------------

    inputs = _verifier_tokenizer(
        prompt,
        return_tensors="pt",
        truncation=True,
        max_length=768,
    )


    # --------------------------------------------------------
    # Ensure tensors are on CPU
    # --------------------------------------------------------

    inputs = {
        key: value.cpu()
        for key, value in inputs.items()
    }


    # --------------------------------------------------------
    # Generate
    # --------------------------------------------------------

    with torch.inference_mode():

        output = _verifier_model.generate(
            **inputs,
            max_new_tokens=48,
            do_sample=False,
            use_cache=True,
            pad_token_id=(
                _verifier_tokenizer.pad_token_id
            ),
            eos_token_id=(
                _verifier_tokenizer.eos_token_id
            ),
        )


    # --------------------------------------------------------
    # Decode only newly generated tokens
    # --------------------------------------------------------

    input_length = (
        inputs["input_ids"].shape[1]
    )

    generated_tokens = output[
        0,
        input_length:
    ]


    text = _verifier_tokenizer.decode(
        generated_tokens,
        skip_special_tokens=True,
    )


    return _parse_verifier_json(
        text
    )


# ------------------------------------------------------------
# External API verifier
# ------------------------------------------------------------

def call_verifier_api(
    question,
    reference,
    policy_answer,
    baseline_answer,
):

    import urllib.request

    api_key = os.environ.get(
        VERIFIER_API_KEY_ENV
    )

    body = json.dumps(
        {
            "question": question,
            "reference": reference,
            "policy_answer": policy_answer,
            "baseline_answer": baseline_answer,
        }
    ).encode("utf-8")


    req = urllib.request.Request(
        VERIFIER_API_URL,
        data=body,
        headers={
            "Content-Type":
                "application/json",
            "Authorization":
                f"Bearer {api_key}",
        },
    )


    with urllib.request.urlopen(
        req,
        timeout=30,
    ) as resp:

        obj = json.loads(
            resp.read().decode("utf-8")
        )


    return _parse_verifier_json(
        json.dumps(obj)
    )


# ------------------------------------------------------------
# Main verification function
# ------------------------------------------------------------

def verify(
    question,
    reference,
    policy_answer,
    baseline_answer,
):

    key = _cache_key(
        question,
        reference,
        policy_answer,
        baseline_answer,
    )


    # --------------------------------------------------------
    # Cache hit
    # --------------------------------------------------------

    if key in _verifier_cache:

        return _verifier_cache[key]


    # --------------------------------------------------------
    # Run verifier
    # --------------------------------------------------------

    if VERIFIER_USE_EXTERNAL_API:

        result = call_verifier_api(
            question,
            reference,
            policy_answer,
            baseline_answer,
        )

    else:

        result = call_verifier_local(
            question,
            reference,
            policy_answer,
            baseline_answer,
        )


    # --------------------------------------------------------
    # Update cache
    # --------------------------------------------------------

    _verifier_cache[key] = result


    # --------------------------------------------------------
    # Save cache
    # --------------------------------------------------------

    os.makedirs(
        os.path.dirname(
            VERIFIER_CACHE_PATH
        ),
        exist_ok=True,
    )

    with open(
        VERIFIER_CACHE_PATH,
        "a",
    ) as f:

        f.write(
            json.dumps(
                {
                    "cache_key": key,
                    "result": result,
                }
            )
            + "\n"
        )


    return result


