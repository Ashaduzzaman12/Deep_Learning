# ---- UNIT TEST: test_test_set_cannot_be_used_for_training ------------------
def test_test_set_cannot_be_used_for_training():
    try:
        DatasetGuard.check("test", "nft_loss")
        raise AssertionError("DatasetGuard failed to block test-split use in training!")
    except AssertionError as e:
        assert "DATA LEAKAGE BLOCKED" in str(e)
    # validation and adaptation must NOT raise
    DatasetGuard.check("validation", "reward_computation")
    DatasetGuard.check("adaptation", "inner_loop_training")
    # test split IS allowed inside the final-eval context
    with DatasetGuard.allow_test_eval():
        DatasetGuard.check("test", "final_held_out_eval")
    print("test_test_set_cannot_be_used_for_training: PASS")

test_test_set_cannot_be_used_for_training()






