# ============================================================
# CELL 8: SYNTHETIC SANITY TEST
# ============================================================
class SyntheticEditEnv:
    """A toy environment: each 'edit' is a scalar theta; reward is a noisy
    function of |theta - target|. Mimics self-edit quality without any LLM."""
    def __init__(self, target=1.0, noise_std=0.1, seed=0):
        self.target = target
        self.noise_std = noise_std
        self.rng = np.random.RandomState(seed)

    def sample_candidates(self, theta_mean, K):
        return self.rng.normal(loc=theta_mean, scale=0.5, size=K)

    def reward(self, theta_values, corrupt_frac=0.0):
        base = -np.abs(theta_values - self.target)
        noisy = base + self.rng.normal(0, self.noise_std, size=len(theta_values))
        if corrupt_frac > 0:
            mask = self.rng.rand(len(theta_values)) < corrupt_frac
            noisy[mask] = -noisy[mask]  # flip sign = corrupted label
        return noisy


def synthetic_rft_step(theta_mean, env, K=8, lr=0.1):
    cands = env.sample_candidates(theta_mean, K)
    rewards = env.reward(cands)
    pos = cands[rewards > np.median(rewards)]
    if len(pos) == 0:
        return theta_mean
    return theta_mean + lr * (pos.mean() - theta_mean)


def synthetic_nft_step(theta_mean, env, K=8, lr=0.1):
    cands = env.sample_candidates(theta_mean, K)
    rewards = env.reward(cands)
    mu, sigma = rewards.mean(), rewards.std() + EPS
    weights = np.clip((rewards - mu) / sigma, CLIP_MIN - CLIP_MAX, CLIP_MAX)  # can be negative
    weights = np.clip(weights, -CLIP_MAX, CLIP_MAX)
    grad = np.sum(weights * (cands - theta_mean)) / K
    return theta_mean + lr * grad


def run_synthetic_tests():
    env = SyntheticEditEnv(target=2.0, noise_std=0.05, seed=0)

    # 1. RFT convergence
    theta = 0.0
    for _ in range(200):
        theta = synthetic_rft_step(theta, env, K=8, lr=0.15)
    assert abs(theta - 2.0) < 0.5, f"Synthetic RFT failed to converge: theta={theta}"

    # 2. NFT uses negative samples (weights can be negative) and converges
    theta2 = 0.0
    for _ in range(200):
        theta2 = synthetic_nft_step(theta2, env, K=8, lr=0.15)
    assert abs(theta2 - 2.0) < 0.6, f"Synthetic NFT failed to converge: theta2={theta2}"

    # 3. Failure memory stores failures (FIFO, bounded)
    mem = deque(maxlen=5)
    for i in range(10):
        mem.append(i)
    assert len(mem) == 5 and list(mem) == [5, 6, 7, 8, 9], "Failure memory FIFO broken"

    # 4. Rollback: reject an update that hurts validation beyond threshold
    def maybe_rollback(before_val, after_val, threshold=ROLLBACK_THRESHOLD):
        return (before_val - after_val) > threshold  # True => rollback

    assert maybe_rollback(0.50, 0.30) is True
    assert maybe_rollback(0.50, 0.495) is False

    # 5. Reward noise: corrupted labels degrade but don't break RFT/NFT math
    env_noisy = SyntheticEditEnv(target=2.0, noise_std=0.05, seed=1)
    cands = env_noisy.sample_candidates(0.0, 8)
    r_clean = env_noisy.reward(cands, corrupt_frac=0.0)
    r_noisy = env_noisy.reward(cands, corrupt_frac=0.3)
    assert r_clean.shape == r_noisy.shape

    return {
        "rft_final_theta": float(theta),
        "nft_final_theta": float(theta2),
        "memory_fifo_ok": True,
        "rollback_ok": True,
        "reward_noise_ok": True,
    }

_synthetic_results = run_synthetic_tests()
print("Synthetic sanity test results:", _synthetic_results)
