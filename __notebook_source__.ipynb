def run_integration_test():
    assert len(EXPERIMENT_CONTEXTS) >= 1, "Need at least one context for integration test."
    test_ctx = EXPERIMENT_CONTEXTS[0]
    compute_log = Counter()
    fm = FailureMemory(size=MEMORY_SIZE)

    print("Integration test: RFT step...")
    chosen, rft_results, before = rft_outer_step(BASE_POLICY_MODEL, policy_tokenizer,
                                                  test_ctx, iteration=0, seed=DEFAULT_SEED,
                                                  evaluation_cache={}, compute_log=compute_log)
    assert len(rft_results) == CFG["K"]
    print("  RFT: PASS  (chosen candidate found:", chosen is not None, ")")

    print("Integration test: NFT step...")
    nft_lora, nft_results, before2, stats = nft_outer_step(
        BASE_POLICY_MODEL, policy_tokenizer, test_ctx, iteration=0, seed=DEFAULT_SEED,
        compute_log=compute_log)
    assert len(nft_results) == CFG["K"]
    discard_candidate_lora(nft_lora)
    print("  NFT: PASS")

    print("Integration test: Negative-SFT step...")
    neg_lora, neg_results, before3, neg_info = negative_sft_outer_step(
        BASE_POLICY_MODEL, policy_tokenizer, test_ctx, iteration=0, seed=DEFAULT_SEED,
        compute_log=compute_log)
    assert len(neg_results) == CFG["K"]
    discard_candidate_lora(neg_lora)
    print("  Negative-SFT: PASS")

    print("Integration test: FASA step...")
    fasa_lora, fasa_results, before4, after4, rollback_info = fasa_outer_step(
        BASE_POLICY_MODEL, policy_tokenizer, test_ctx, iteration=0, seed=DEFAULT_SEED,
        compute_log=compute_log, failure_memory=fm)
    assert len(fasa_results) == CFG["K"]
    if fasa_lora is not None:
        discard_candidate_lora(fasa_lora)
    print("  FASA: PASS  (rollback triggered:", rollback_info["rolled_back"], ")")

    print("\nCompute log from integration test:", dict(compute_log))
    print("Failure memory size after integration test:", len(fm))
    return True

