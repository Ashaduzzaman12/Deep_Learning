# CELL 23: CONTINUAL-LEARNING EXPERIMENT
# ============================================================
def run_continual_learning(method_label, step_kind, seed, contexts):
    """Sequentially adapts on each context (single outer step per context, using
    that context's own K self-edits), and after each adaptation evaluates ALL
    contexts seen so far on validation. Returns the M[i][j] matrix (i=task,
    j=adaptation step) as a DataFrame, plus the running policy LoRA usage log."""
    set_all_seeds(seed)
    compute_log = Counter()
    failure_memory = FailureMemory(size=MEMORY_SIZE)
    N = len(contexts)
    M = np.full((N, N), np.nan)

    # Track a single "current" LoRA policy across the whole sequence (continual
    # adaptation is cumulative -- this differs from the per-context-isolated
    # main experiment, which is intentional and documented in the report).
    current_lora = fresh_lora_policy(BASE_POLICY_MODEL)

    for j, ctx_j in enumerate(contexts):
        if step_kind == "RFT":
            candidates = generate_self_edits(current_lora, policy_tokenizer, ctx_j["passage"],
                                              CFG["K"], j, mode="implications",
                                              max_new_tokens=CFG["max_new_tokens_edit"], base_seed=seed)
            before = evaluate_questions(current_lora, policy_tokenizer, ctx_j["passage"], ctx_j["validation"],
                                         "validation", "reward_computation",
                                         max_new_tokens=CFG["max_new_tokens_answer"])
            best_reward, best_edit = -1e9, None
            for cand in candidates:
                trial = fresh_lora_policy(BASE_POLICY_MODEL)
                train_candidate_lora(trial, policy_tokenizer, cand["edit_text"], CFG["inner_steps"], CFG["lr"])
                after = evaluate_questions(trial, policy_tokenizer, ctx_j["passage"], ctx_j["validation"],
                                            "validation", "reward_computation",
                                            max_new_tokens=CFG["max_new_tokens_answer"])
                rw = after["EM"] - before["EM"]
                discard_candidate_lora(trial)
                if rw > best_reward:
                    best_reward, best_edit = rw, cand["edit_text"]
            if best_edit is not None and best_reward > 0:
                train_candidate_lora(current_lora, policy_tokenizer, best_edit, CFG["inner_steps"], CFG["lr"])

        elif step_kind in ("NFT", "FASA"):
            candidates = generate_self_edits(current_lora, policy_tokenizer, ctx_j["passage"],
                                              CFG["K"], j, mode="implications",
                                              max_new_tokens=CFG["max_new_tokens_edit"], base_seed=seed)
            before = evaluate_questions(current_lora, policy_tokenizer, ctx_j["passage"], ctx_j["validation"],
                                         "validation", "reward_computation",
                                         max_new_tokens=CFG["max_new_tokens_answer"])
            rewards = []
            for cand in candidates:
                trial = fresh_lora_policy(BASE_POLICY_MODEL)
                train_candidate_lora(trial, policy_tokenizer, cand["edit_text"], CFG["inner_steps"], CFG["lr"])
                after = evaluate_questions(trial, policy_tokenizer, ctx_j["passage"], ctx_j["validation"],
                                            "validation", "reward_computation",
                                            max_new_tokens=CFG["max_new_tokens_answer"])
                rw = after["EM"] - before["EM"]
                rewards.append(rw)
                discard_candidate_lora(trial)
                if step_kind == "FASA" and rw <= 0:
                    failure_memory.add({"context_id": ctx_j["context_id"], "edit": cand["edit_text"],
                                         "reward": rw, "delta_accuracy": rw,
                                         "failure_type": classify_failure(rw), "iteration": j, "seed": seed})
            stats = estimate_reward_statistics(rewards)
            weights = compute_nft_weights(rewards, stats)
            prev_state = copy.deepcopy(current_lora.state_dict())
            train_nft_step(current_lora, policy_tokenizer, list(zip(candidates, weights)), CFG["lr"])
            if step_kind == "FASA":
                after_update = evaluate_questions(current_lora, policy_tokenizer, ctx_j["passage"],
                                                    ctx_j["validation"], "validation", "reward_computation",
                                                    max_new_tokens=CFG["max_new_tokens_answer"])
                should_rb, _ = rollback_gate(before["EM"], after_update["EM"])
                if should_rb:
                    current_lora.load_state_dict(prev_state)
        else:
            raise ValueError(step_kind)

        # Evaluate all tasks seen so far (0..j) on validation
        for i in range(j + 1):
            m = evaluate_questions(current_lora, policy_tokenizer, contexts[i]["passage"],
                                    contexts[i]["validation"], "validation", "reward_computation",
                                    max_new_tokens=CFG["max_new_tokens_answer"])
            M[i, j] = m["EM"]
        gc.collect()
        if torch.cuda.is_available():
            torch.cuda.empty_cache()

    discard_candidate_lora(current_lora)
    return M


N_CONTINUAL = min(len(EXPERIMENT_CONTEXTS), CFG["contexts"], 8 if DEBUG else 20)
continual_contexts = EXPERIMENT_CONTEXTS[:N_CONTINUAL]
CONTINUAL_MATRICES = {}
CONTINUAL_METRICS = {}

for method_label, step_kind in [("RFT", "RFT"), ("NFT", "NFT"), ("FASA", "FASA")]:
    print(f"Running continual-learning sequence for {method_label} "
          f"({N_CONTINUAL} contexts, seed={DEFAULT_SEED}) ...")
    M = run_continual_learning(method_label, step_kind, DEFAULT_SEED, continual_contexts)
    CONTINUAL_MATRICES[method_label] = M

    N = M.shape[0]
    F_i = np.array([np.nanmax(M[i, i:]) - M[i, N - 1] for i in range(N)])
    if N > 1:
        BWT = np.mean([M[i, N - 1] - M[i, i] for i in range(N - 1)])
    else:
        BWT = 0.0
    CONTINUAL_METRICS[method_label] = {"avg_forgetting": float(np.nanmean(F_i)), "BWT": float(BWT)}
    print(f"  {method_label}: avg forgetting = {np.nanmean(F_i):.4f}, BWT = {BWT:.4f}")

np.save(os.path.join(OUTPUT_ROOT, "raw", "continual_matrices.npy"), CONTINUAL_MATRICES, allow_pickle=True)
with open(os.path.join(OUTPUT_ROOT, "processed", "continual_metrics.json"), "w") as f:
    json.dump(CONTINUAL_METRICS, f, indent=2)
print("\nContinual-learning metrics:", CONTINUAL_METRICS)







