# CELL 11: DETERMINISTIC EVALUATOR
# ============================================================
def normalize_answer(s):
    s = s.lower()
    s = "".join(ch for ch in s if ch not in set(string.punctuation))
    s = re.sub(r"\b(a|an|the)\b", " ", s)
    s = " ".join(s.split())
    return s

def exact_match_score(prediction, references):
    p = normalize_answer(prediction)
    return float(any(p == normalize_answer(r) for r in references))

def f1_score_single(prediction, reference):
    pred_tokens = normalize_answer(prediction).split()
    ref_tokens = normalize_answer(reference).split()
    if len(pred_tokens) == 0 or len(ref_tokens) == 0:
        return float(pred_tokens == ref_tokens)
    common = Counter(pred_tokens) & Counter(ref_tokens)
    num_same = sum(common.values())
    if num_same == 0:
        return 0.0
    precision = num_same / len(pred_tokens)
    recall = num_same / len(ref_tokens)
    return 2 * precision * recall / (precision + recall)

def f1_score(prediction, references):
    return max(f1_score_single(prediction, r) for r in references)


def generate_answer(model, tokenizer, passage, question, max_new_tokens=24, use_passage=False):
    if use_passage:
        prompt = f"Passage: {passage}\nQuestion: {question}\nAnswer:"
    else:
        prompt = f"Question: {question}\nAnswer:"
    inputs = tokenizer(prompt, return_tensors="pt", truncation=True, max_length=768).to(model.device)
    with torch.no_grad():
        out = model.generate(
            **inputs, max_new_tokens=max_new_tokens, do_sample=False,
            pad_token_id=tokenizer.pad_token_id,
        )
    text = tokenizer.decode(out[0][inputs["input_ids"].shape[1]:], skip_special_tokens=True)
    return text.strip().split("\n")[0].strip()


def evaluate_questions(model, tokenizer, passage, questions, split_label, purpose,
                        use_passage=False, max_new_tokens=24):
    """Evaluate model on a list of {question, answers} dicts. NEVER pass
    split='test' unless inside DatasetGuard.allow_test_eval()."""
    DatasetGuard.check(split_label, purpose)
    em_list, f1_list, records = [], [], []
    for q in questions:
        pred = generate_answer(model, tokenizer, passage, q["question"],
                                max_new_tokens=max_new_tokens, use_passage=use_passage)
        em = exact_match_score(pred, q["answers"])
        f1 = f1_score(pred, q["answers"])
        em_list.append(em)
        f1_list.append(f1)
        records.append({"question": q["question"], "prediction": pred,
                         "reference": q["answers"][0], "em": em, "f1": f1})
    return {
        "EM": float(np.mean(em_list)) if em_list else 0.0,
        "F1": float(np.mean(f1_list)) if f1_list else 0.0,
        "records": records,
    }

print("Deterministic evaluator (normalized EM / token-F1) ready.")






