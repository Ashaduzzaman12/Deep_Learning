def run_fasa_variant_over_contexts(seed, contexts, outer_iterations,
                                    use_nft, use_memory, use_rollback, label):
    set_all_seeds(seed)
    compute_log = Counter()
    failure_memory = FailureMemory(size=MEMORY_SIZE)
    rows = []
    rollback_count = 0
    for ctx in contexts:
        for it in range(outer_iterations):
            lora, results, before, after_eval, rb_info = fasa_outer_step(
                BASE_POLICY_MODEL, policy_tokenizer, ctx, it, seed, compute_log,
                failure_memory=failure_memory,
                use_nft=use_nft, use_memory=use_memory, use_rollback=use_rollback)
            after_EM = after_eval["EM"]
            if rb_info["rolled_back"]:
                rollback_count += 1
            if lora is not None:
                discard_candidate_lora(lora)
            for r in results:
                rows.append({"method": label, "seed": seed, "context_id": ctx["context_id"],
                             "iteration": it, "reward": r.get("reward"),
                             "delta_accuracy": r.get("delta_accuracy"),
                             "before_EM": before["EM"], "after_EM": after_EM,
                             "rolled_back": rb_info["rolled_back"]})
            gc.collect()
            if torch.cuda.is_available():
                torch.cuda.empty_cache()
    return rows, dict(compute_log), rollback_count


