# NOTE: for methods that don't persist a single final policy in the main-experiment
# driver (each outer step in Cell 21 evaluates candidate LoRAs that are then
# discarded), we re-run one final adaptation per context using the *already
# chosen best validation-selected* self-edit/weights from the LAST outer
# iteration logged in main_results_df, purely for a clean, leakage-safe final
# test read-out.
import difflib

def repeated_failure_rate(failure_records, sim_threshold=0.9):
    """Fraction of failure records whose edit text is a near-duplicate
    (similarity >= sim_threshold) of an earlier one in the same sequence.
    Robust to records missing 'edit_text' (e.g. some FASA records use a
    different field name) -- such records are skipped, not fatal.
    """
    seen_texts = []
    repeated = 0
    n_valid = 0
    skipped_keys = set()

    for rec in failure_records:
        text = None
        if isinstance(rec, dict):
            for key in ("edit_text", "text", "candidate_text", "self_edit_text"):
                if key in rec:
                    text = rec[key]
                    break
            if text is None:
                skipped_keys.update(rec.keys())
        if text is None:
            continue

        n_valid += 1
        is_repeat = any(
            difflib.SequenceMatcher(None, text, prev).ratio() >= sim_threshold
            for prev in seen_texts
        )
        if is_repeat:
            repeated += 1
        seen_texts.append(text)

    if skipped_keys:
        print(f"  [warn] repeated_failure_rate: skipped records with no "
              f"recognized text key; keys seen instead: {skipped_keys}")

    return repeated / n_valid if n_valid else float("nan")
def final_test_eval_for_method(method, contexts, seed):
    sub = main_results_df[(main_results_df["method"] == method) & (main_results_df["seed"] == seed)]
    if len(sub) == 0:
        return {"EM": float("nan"), "F1": float("nan")}
    em_list, f1_list = [], []
    with DatasetGuard.allow_test_eval():
        for ctx in contexts:
            ctx_rows = sub[sub["context_id"] == ctx["context_id"]]
            if len(ctx_rows) == 0:
                continue
            last_iter = ctx_rows["iteration"].max()
            best_row = ctx_rows[ctx_rows["iteration"] == last_iter].sort_values(
                "reward", ascending=False).iloc[0]
            edit_text = best_row.get("edit_text", "")
            if not edit_text:
                m = evaluate_questions(BASE_POLICY_MODEL, policy_tokenizer, ctx["passage"], ctx["test"],
                                        "test", "final_held_out_eval",
                                        max_new_tokens=CFG["max_new_tokens_answer"])
            else:
                trial = fresh_lora_policy(BASE_POLICY_MODEL)
                train_candidate_lora(trial, policy_tokenizer, edit_text, CFG["inner_steps"], CFG["lr"])
                m = evaluate_questions(trial, policy_tokenizer, ctx["passage"], ctx["test"],
                                        "test", "final_held_out_eval",
                                        max_new_tokens=CFG["max_new_tokens_answer"])
                discard_candidate_lora(trial)
            em_list.append(m["EM"]); f1_list.append(m["F1"])
    return {"EM": float(np.mean(em_list)) if em_list else float("nan"),
            "F1": float(np.mean(f1_list)) if f1_list else float("nan")}


