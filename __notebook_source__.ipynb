METHOD_STEP_FNS = {}  # populated below to keep step-fn signatures uniform

def run_method_over_contexts(method_name, step_fn_kind, seed, contexts, outer_iterations):
    """Generic driver: runs `outer_iterations` outer steps per context for one method,
    one seed. Returns a results dataframe-ready list and a compute log."""
    set_all_seeds(seed)
    compute_log = Counter()
    failure_memory = FailureMemory(size=MEMORY_SIZE)
    rows = []
    rollback_count = 0

    for ctx in contexts:
        for it in range(outer_iterations):
            t0 = time.time()
            if method_name == "RFT":
                chosen, results, before = rft_outer_step(
                    BASE_POLICY_MODEL, policy_tokenizer, ctx, it, seed, {}, compute_log)
                after_EM = max([r["after_EM"] for r in results]) if results else before["EM"]
                rolled_back = False
            elif method_name == "NFT":
                lora, results, before, stats = nft_outer_step(
                    BASE_POLICY_MODEL, policy_tokenizer, ctx, it, seed, compute_log)
                after_eval = evaluate_questions(lora, policy_tokenizer, ctx["passage"], ctx["validation"],
                                                 "validation", "reward_computation",
                                                 max_new_tokens=CFG["max_new_tokens_answer"])
                after_EM = after_eval["EM"]
                discard_candidate_lora(lora)
                rolled_back = False
            elif method_name == "Negative-SFT":
                lora, results, before, info = negative_sft_outer_step(
                    BASE_POLICY_MODEL, policy_tokenizer, ctx, it, seed, compute_log)
                after_eval = evaluate_questions(lora, policy_tokenizer, ctx["passage"], ctx["validation"],
                                                 "validation", "reward_computation",
                                                 max_new_tokens=CFG["max_new_tokens_answer"])
                after_EM = after_eval["EM"]
                discard_candidate_lora(lora)
                rolled_back = False
            elif method_name == "FASA":
                lora, results, before, after_eval, rb_info = fasa_outer_step(
                    BASE_POLICY_MODEL, policy_tokenizer, ctx, it, seed, compute_log,
                    failure_memory=failure_memory)
                after_EM = after_eval["EM"]
                rolled_back = rb_info["rolled_back"]
                if lora is not None:
                    discard_candidate_lora(lora)
                if rolled_back:
                    rollback_count += 1
            else:
                raise ValueError(method_name)

            wall_time = time.time() - t0
            compute_log["wall_clock_seconds"] += wall_time
            for r in results:
                rows.append({
                    "method": method_name, "seed": seed, "context_id": ctx["context_id"],
                    "iteration": it, "candidate_id": r.get("candidate_id"),
                    "reward": r.get("reward"), "delta_accuracy": r.get("delta_accuracy"),
                    "before_EM": before["EM"], "after_EM": after_EM,
                    "rolled_back": rolled_back,
                    "edit_text": r.get("edit_text", ""),
                })
            gc.collect()
            if torch.cuda.is_available():
                torch.cuda.empty_cache()

    return rows, dict(compute_log), failure_memory, rollback_count


