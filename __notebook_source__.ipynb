def classify_claim(delta, effect_size, p_value, preliminary, achievable=True):
    if not achievable:
        return "INCONCLUSIVE"
    if preliminary:
        return "INCONCLUSIVE" if abs(delta) < 0.01 else "PARTIALLY_SUPPORTED"
    if delta > 0.01 and (not np.isnan(effect_size)) and abs(effect_size) >= 0.5 and (
            np.isnan(p_value) or p_value < 0.1):
        return "SUPPORTED"
    if delta > 0:
        return "PARTIALLY_SUPPORTED"
    return "NOT_SUPPORTED"


